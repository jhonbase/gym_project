generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String         @id @default(uuid())
  nombre       String
  documento    String         @unique
  email        String         @unique 
  createAt     DateTime       @default(now())
  fingerprints Fingerprint[]
}

model Fingerprint {
  id        String   @id @default(uuid()) 
  userId    String
  template  String
  createAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
