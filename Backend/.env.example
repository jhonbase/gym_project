# ─── Base de datos PostgreSQL ────────────────────────────────────────────────
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd?schema=public
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/proyecto?schema=public"

# ─── Puerto del servidor ─────────────────────────────────────────────────────
PORT=3000

# ─── Entorno ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API Key de Groq ─────────────────────────────────────────────────────────
# Necesaria para el análisis de valoraciones con IA.
# Obtener en: https://console.groq.com/keys
# ¡NUNCA commitear el valor real! Revocarlo inmediatamente si se expone.
GROQ_API_KEY=

# ─── JWT Secret ──────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens de sesión.
# Usar un string largo y aleatorio. Ejemplo: openssl rand -base64 64
# ¡NUNCA usar el valor por defecto en producción!
JWT_SECRET=

# ─── JWT Expiración ──────────────────────────────────────────────────────────
# Tiempo de vida del token. Formatos: 8h, 1d, 7d, etc.
JWT_EXPIRES_IN=8h

# ─── CORS Origin permitido ───────────────────────────────────────────────────
# URL exacta del frontend. En producción: https://tu-dominio.com
# Sin esto, cualquier sitio del mundo puede hacer peticiones a la API.
ALLOWED_ORIGIN=http://localhost:5173
