# Base de datos PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd?schema=public
DATABASE_URL=


# Puerto del servidor
PORT=


# Entorno
NODE_ENV=


# API Key de Groq
GROQ_API_KEY=


# JWT Secret
JWT_SECRET=


# JWT Expiración
JWT_EXPIRES_IN=


# CORS Origins permitidos (producción)
ALLOWED_ORIGINS=


# GMAIL
GMAIL_USER=
GMAIL_PASSWORD=
FRONTEND_URL=


# Deep Links para app móvil
# Desarrollo: URL de Expo Go con IP del equipo (ipconfig para encontrar tu IP)
# Producción: esquema personalizado de la app
EXPO_DEV_URL=
EXPO_PROD_URL=
EXPO_DEV_WEB_URL=


# CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=