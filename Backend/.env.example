# ---- Base de datos PostgreSQL ----
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd?schema=public
DATABASE_URL=

# ---- Puerto del servidor ----
PORT=

# ---- Entorno ----
NODE_ENV=

# ---- API Key de Groq ----
# Necesaria para el análisis de valoraciones con IA.
# Obtener en: https://console.groq.com/keys
# ¡NUNCA commitear el valor real! Revocarlo inmediatamente si se expone.
GROQ_API_KEY=

# ---- JWT Secret ----
# Clave secreta para firmar los tokens de sesión.
# Usar un string largo y aleatorio. Ejemplo: openssl rand -base64 64
# ¡NUNCA usar el valor por defecto en producción
JWT_SECRET=

# ---- JWT Expiración ----
# Tiempo de vida del token. Formatos: 8h, 1d, 7d, etc.
JWT_EXPIRES_IN=

# ---- CORS Origins permitidos (producción) ----
# Lista de dominios separados por coma. Solo se usa en producción.
# En desarrollo se permite automáticamente: localhost, 127.0.0.1, 192.168.x.x
# Ejemplo: ALLOWED_ORIGINS=https://unifit.com,https://www.unifit.com
ALLOWED_ORIGINS=

# ---- GMAIL ----
GMAIL_USER=
GMAIL_PASSWORD=
FRONTEND_URL=

# ---- Deep Links para app móvil ----
# Desarrollo: URL de Expo Go con IP del equipo (ipconfig para encontrar tu IP)
# Producción: esquema personalizado de la app
EXPO_DEV_URL=
EXPO_PROD_URL=
EXPO_DEV_WEB_URL=

# ---- CLOUDINARY ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=