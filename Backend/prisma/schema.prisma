generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- USUARIO ----
model User {
  id                 String        @id @default(uuid())
  nombre             String
  documento          String        @unique
  tipoDocumento      String        // CC, TI, CE, RC
  numeroCarnet       String        @unique
  email              String        @unique
  telefono           String        @unique
  fechaNacimiento    DateTime?
  eps                String
  grupoSanguineo     String        // Ej: "O+", "A-", "B+", "AB-"
  contactoEmergencia String        // Nombre + teléfono del contacto
  programa           String
  modalidad          String
  jornada            String        // Ej: "diurna", "nocturna"
  semestre           Int
  esEgresado         Boolean       @default(false)
  rol                String        @default("usuario") // "usuario" | "entrenador" | "admin"
  disponibilidad     String        @default("NO_DISPONIBLE") // DISPONIBLE | OCUPADO | NO_DISPONIBLE
  cuentaActivada    Boolean       @default(false)
  tokenActivacion    String?
  tokenActivacionExpira DateTime?
  certificadoEps     String?       // Ruta del certificado de EPS (PDF)
  genero             String?
  generoOtro         String?
  institucion        String?
  password          String?       // Password para login (solo trainers)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relaciones
  fingerprints       Fingerprint[]
  assessments        Assessment[]
}

// ---- HUELLA DACTILAR ----
// Almacena el template
// Un usuario puede tener múltiples huellas registradas (ej: distintos dedos).
model Fingerprint {
  id        String   @id @default(uuid())
  userId    String
  template  String   // String de 64 caracteres (simulación) o datos reales del SDK
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---- VALORACIÓN FÍSICA ----
// Datos que el entrenador registra después de la evaluación física.
model Assessment {
  id                   String   @id @default(uuid())
  userId               String

  // Medidas corporales
  peso                 Float    
  estatura             Float    
  grasaCorporal        Float    
  masaMuscular         Float    
  imc                  Float    
  masaMagra            Float?    
  aguaCorporal         Float?    
  grasaVisceral        Int      

  // Datos clínicos
  presionArterial      String   
  edadMetabolica       Int      
  fuerzaAgarre         Float    
  resistenciaMuscular  String   
  rmEstimado           Float    
  ppm                   Int      

  // Antecedentes Clínicos
  lesionesEvidencia   String[] // Array de rutas de archivos de lesiones
  lesionDescripcion String?       // Descripción de la lesión
  historialClinico String?     // Ruta del archivo de historial clínico (único)

  // Antecedentes de salud
  anteOsteomuscular    Boolean  @default(false)
  anteOsteomuscularDesc String?
  anteCardiovascular   Boolean  @default(false)
  anteCardiovascularDesc String?
  anteRespiratorio     Boolean  @default(false)
  anteRespiratorioDesc String?
  anteMetabolico       Boolean  @default(false)
  anteMetabolicoDesc   String?
  antePsiquiatrico    Boolean  @default(false)
  antePsiquiatricoDesc String?
  antePsicologico      Boolean  @default(false)
  antePsicologicoDesc String?

  // Contexto
  nivelActividadFisica String   
  diasDisponibles      String[] // Días disponibles para entrenar: ["lunes", "miercoles", "viernes"]
  observacion          String?  
  objetivoUsuario      String   
  proximaFechaValoracion DateTime? // Fecha programada para la próxima valoración

  // Análisis IA
  analisisIA           String?  
  planEntrenamiento   String?  // Plan de entrenamiento generado por IA
  estadoValoracion     String   @default("pendiente") // "pendiente" | "completada" | "analizada"

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
