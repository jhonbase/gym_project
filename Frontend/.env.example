# ─── Frontend — Variables de entorno ─────────────────────────────────────────
# Copia este archivo como .env.local para desarrollo local.
# Las variables que empiezan con VITE_ son expuestas al navegador (no pongas secrets aquí).

# URL base de la API — solo necesaria si separas frontend y backend en dominios distintos.
# Con Netlify + redirect /api/* esto NO es necesario (déjala vacía o no la crees).
# VITE_API_URL=https://tu-backend.com
